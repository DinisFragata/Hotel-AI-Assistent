generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  MAINTENANCE
  OUT_OF_ORDER
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum OperationType {
  CHECK_IN
  CHECK_OUT
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  maintenance Maintenance[]
}

model Room {
  id          String     @id @default(cuid())
  number      String     @unique
  floor       Int?
  status      RoomStatus @default(AVAILABLE)
  capacity    Int        @default(2)
  pricePerNight Decimal  @db.Decimal(10, 2)

  reservations Reservation[]
  maintenance  Maintenance[]
}

model Guest {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String?
  phone     String?
  createdAt DateTime @default(now())

  reservations Reservation[]
}

model Reservation {
  id          String            @id @default(cuid())
  checkIn     DateTime
  checkOut    DateTime
  guestsCount Int
  status      ReservationStatus @default(PENDING)
  totalPrice  Decimal           @db.Decimal(10, 2)

  guestId String
  roomId  String

  guest Guest @relation(fields: [guestId], references: [id])
  room  Room  @relation(fields: [roomId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Operation {
  id        String        @id @default(cuid())
  type      OperationType
  guestName String
  time      DateTime
  roomId    String

  room Room @relation(fields: [roomId], references: [id])

  createdAt DateTime @default(now())
}

model Maintenance {
  id          String             @id @default(cuid())
  title       String
  description String?
  status      MaintenanceStatus  @default(OPEN)
  createdAt   DateTime            @default(now())
  completedAt DateTime?

  roomId String?
  userId String?

  room Room? @relation(fields: [roomId], references: [id])
  user User? @relation(fields: [userId], references: [id])
}

model AIInsight {
  id        String   @id @default(cuid())
  room      String?
  title     String
  text      String
  action    String?
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now())
}